################Step 4: Merge and Filter VCF Files################
# Function: This script merges individual VCF files, applies PLINK filters, and converts the files to PLINK format.
# It will be helpful to run this as an sh file.
#WARNING: MULTITHREADED

#!/bin/bash
#PBS -q normal
#PBS -l select=1:ncpus=4:mem=64G
#PBS -l walltime=24:00:00
#PBS -N Merge_vcf
#PBS -P Personal

cd $PBS_O_WORKDIR

# Define directories
OUT_DIR="/path/to/OUTPUT_FILES" # Directory for PLINK files
PLINK="/home/users/nus/aleemj/plink"     # Path to the PLINK executable
BCF_DIR="/path/to/individual_bcf"            # Replace with the actual output directory path

# Create directories only if they do not exist
[ ! -d "$OUT_DIR" ] && mkdir -p "$OUT_DIR"

# Load bcftools module
module load bcftools

# Save the BCF files into a single text file
find "$BCF_DIR" -type f -name "*.bcf" | sort | uniq > \
    "$BCF_DIR/bcfs_merge.txt"

# Merging the indexed BCF files using 4 threads
cat "$BCF_DIR/bcfs_merge.txt" | xargs bcftools concat -a --threads 4 -o "$OUT_DIR/Merged_BeforeFilter.vcf.gz" -O z

echo "####################"
echo "BCF MERGING COMPLETE"
echo "####################"

#index merged vcf file
bcftools index --threads 4 "$OUT_DIR/Merged_BeforeFilter.vcf.gz"

# Convert the merged VCF to PLINK format
$PLINK --vcf "$OUT_DIR/Merged_BeforeFilter.vcf.gz" --keep-allele-order --allow-extra-chr --allow-no-sex --double-id --make-bed --out "$OUT_DIR/filtered_samples_temp"

# Apply SNPs only filter
$PLINK --bfile "$OUT_DIR/filtered_samples_temp" --keep-allele-order --allow-extra-chr --allow-no-sex --snps-only --make-bed --out "$OUT_DIR/filtered_samples_snps"

# Apply missing genotype filter
$PLINK --bfile "$OUT_DIR/filtered_samples_snps" --keep-allele-order --allow-extra-chr --allow-no-sex --geno 0.1 --make-bed --out "$OUT_DIR/filtered_samples_snps_geno"

# Apply MAF filter
$PLINK --bfile "$OUT_DIR/filtered_samples_snps_geno" --keep-allele-order --allow-extra-chr --allow-no-sex --maf 0.05 --make-bed --out "$OUT_DIR/filtered_samples_snps_geno_maf"

# Deal with duplicate variant ID names
$PLINK --bfile "$OUT_DIR/filtered_samples_snps_geno_maf" --keep-allele-order --allow-extra-chr --allow-no-sex --set-missing-var-ids @:# --make-bed --out "$OUT_DIR/final"

# Create a PED file from the BED file
$PLINK --bfile "$OUT_DIR/final" --keep-allele-order --allow-no-sex --allow-extra-chr --recode --tab --out "$OUT_DIR/final"

# Create a final VCF file from the BED file
$PLINK --bfile "$OUT_DIR/final" --keep-allele-order --allow-no-sex --allow-extra-chr --recode vcf --out "$OUT_DIR/final"
