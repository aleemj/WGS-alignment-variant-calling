################Step 3: Variant Calling step################
# Function: This script performs joint variant calling using bcftools for all samples, by chromosome.
# IMPORTANT: Create and run one sh file per chromosone, edit chromosome names accordingly.
# It will be helpful to run this as an sh file.

#!/bin/bash
#PBS -q normal
#PBS -l select=1:ncpus=4:mem=64G
#PBS -l walltime=24:00:00
#PBS -N VariantCall
#PBS -P Personal

# Load modules required for this step
module load bcftools

# Define directories
REFERENCE_GENOME="/path/to/reference.fa"
BAM_DIR=<INPUT> #IMPT TO CHANGE - Folder in which all BAM files are
BCF_DIR=<INPUT> #IMPT TO CHANGE - Folder to store output BCF files

# Change directory to the directory where shell script is located for collection of log files
cd $PBS_O_WORKDIR

# if no log folder, then make one
[ -d log ] || mkdir log

# Collating the filenames of all BAM files into a .txt file for bcftools multiple sample variant calling
# in the same directory as where the BAM files were.
find "$BAM_DIR" -type f -name "*.bam" | sort | uniq > \
    "$BAM_DIR/BAMfile_list.txt"

# Specifying the chromosome number to the "CHRNO" variable, according to the RNAME of the aligned reads in the BAM file.
# Change accordingly to the scaffold/chromosome you wish to call variants for.
export CHRNO=1

# Perform BCFtools commands using 4 threads, previously determined to have optimal trade-off between computational resource and time.
# Change the name of the actual FASTA file accordingly
bcftools mpileup --threads 4 -Ou -q 20 -Q 30 -f "$REFERENCE_GENOME" \
        -r "CHR_$CHRNO" -b "$(echo $BAM_DIR/BAMfile_list.txt)" | \
        bcftools call --threads 4 -mv -Ob \
        -o "$BCF_DIR/variants_chr$CHRNO.bcf"

echo "########################"
echo "VARIANT CALLING COMPLETE"
echo "########################"
